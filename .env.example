# NIRF Insight Environment Configuration Template
PROJECT_NAME="NIRF Insight: India State-wise Ranking Distribution Dashboard"
PROJECT_VERSION="2.0.0"

# Application Environment (development / production)
ENVIRONMENT=production

# Database Configuration (PostgreSQL / SQLite Dual Engine)
# For local embedded testing (default):
DATABASE_URL=sqlite:///nirf_v2.db

# For Production Managed PostgreSQL:
# DATABASE_URL=postgresql://nirf_user:StrongPassword123@localhost:5432/nirf_db

POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=nirf_db
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Server Port
PORT=8000
HOST=127.0.0.1
